GITHUB_TOKEN=
PORT=3001
# Root directory holding local clones of reviewed repos, one subfolder per repo
# name (e.g. F:\GFS_SaaS\gfs-saas-core). When a reviewed repo is found here,
# the review runs with codebase access (Read/Grep/Glob) instead of diff-only.
# Leave unset to always fall back to diff-only review.
LOCAL_REPOS_ROOT=
