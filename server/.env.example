GITHUB_TOKEN=
PORT=3011
# Root directory holding local clones of reviewed repos, one subfolder per repo
# name (e.g. F:\GFS_SaaS\gfs-saas-core). When a reviewed repo is found here,
# the review runs with codebase access (Read/Grep/Glob) instead of diff-only.
# Leave unset to always fall back to diff-only review.
LOCAL_REPOS_ROOT=
# Full path to the claude CLI executable. Only needed if `claude` doesn't resolve
# on PATH in this server process's environment (e.g. it's only available via a
# VSCode extension's own PATH injection, not a standalone install) — leave unset
# to just run `claude` and rely on PATH.
CLAUDE_CLI_PATH=
